{
  "name": "vou-de-que-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Vou de Quê?: compara carro e transporte público em tempo real",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@here/flexpolyline": "^0.1.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
